<% if user_signed_in? %>
  <div class="card p-5">
    <h2><%= defined?(title) ? title : "Deixe sua avaliação" %></h2>
    <%= form_with(model: review, id: "form-" + review.id, data: { turbo: false }) do |form| %>
    <%= form.hidden_field :user_id, value: current_user.id %>
    <%= form.hidden_field :movie_id, value: movie.id %>
    <% if review.errors.any? %>
        <div class="alert alert-danger">
        <h6 class="fw-bold"><%= pluralize(review.errors.count, "erro") %> impediram o salvamento:</h6>
        <ul class="mb-0">
          <% review.errors.each do |error| %>
          <li><%= error.full_message %></li>
          <% end %>
        </ul>
        </div>
    <% end %>

    <div class="mb-3">
        <%= form.label :nota, class: "form-label fw-semibold me-2" %>
        <%= form.hidden_field :nota, class: "form-control" %>
        <span class="text-primary input-nota">
        <% 5.times do |i| %>
          <span style="cursor: pointer;">
            <i data-index="<%= i %>"class="bi bi-star fs-3"></i>
          </span>
        <% end %>
        </span>
    </div>
    <div class="mb-3">
        <%= form.label :titulo, class: "form-label fw-semibold" %>
        <%= form.text_field :titulo, class: "form-control #{"is-invalid" if review.errors[:titulo].any?}" %>
        <% if review.errors[:titulo].any? %>
        <div class="invalid-feedback d-block">
          <%= review.errors[:titulo].join(", ") %>
        </div>
        <% end %>
    </div>
    <div class="mb-3">
        <%= form.label :avaliacao, class: "form-label fw-semibold" %>
        <%= form.text_area :avaliacao, class: "form-control #{"is-invalid" if review.errors[:avaliacao].any?}", rows: 4 %>
        <% if review.errors[:avaliacao].any? %>
        <div class="invalid-feedback d-block">
          <%= review.errors[:avaliacao].join(", ") %>
        </div>
        <% end %>
    </div>
    <div class="d-flex gap-2 mt-4">
      <%= form.submit "Postar Avaliação", class: "btn btn-primary" %>
    </div>
    <% end %>
  </div>

  <script>
    {
      const form = document.getElementById("form-<%= review.id%>")
      const inputNotaHidden = form.querySelector("input[name='review[nota]']")
      const inputNota = form.querySelector(".input-nota");
      const stars = inputNota.querySelectorAll("span");
      let clicked = false;
      
      stars.forEach((starContainer) => {
        starContainer.addEventListener("mouseover", (e) => {
          if (clicked) return;
          const selectedStarIndex = parseInt(starContainer.querySelector("i").dataset.index);
          stars.forEach((span) => {
            if(parseInt(span.querySelector("i").dataset.index) <= selectedStarIndex) {
              span.querySelector("i").classList.replace("bi-star", "bi-star-fill");
            }
          });
        });

        starContainer.addEventListener("mouseleave", (e) => {
          if (clicked) return;
          stars.forEach((span) => {
            span.querySelector("i").classList.replace("bi-star-fill", "bi-star");
          });
        });

        starContainer.addEventListener("click", () => {
          const selectedStarIndex = parseInt(starContainer.querySelector("i").dataset.index);
          stars.forEach((span) => {
            if(parseInt(span.querySelector("i").dataset.index) <= selectedStarIndex) {
              span.querySelector("i").classList.replace("bi-star", "bi-star-fill");
            } else {
              span.querySelector("i").classList.replace("bi-star-fill", "bi-star");
            }
          });
          clicked = true;
          inputNotaHidden.value = inputNota.querySelectorAll(".bi-star-fill").length;
        })
      });

      if (inputNotaHidden.value != "") {
        inputNota.querySelector('[data-index="' + (parseInt(inputNotaHidden.value) - 1) + '"]').click();
      }
    }
  </script>
<% end %>