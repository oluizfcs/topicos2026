<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold">Editar Filme</h1>
    <div>
      <%= link_to "Ver", [:admin, @movie], class: "btn btn-outline-info me-2" %>
      <%= link_to "Voltar", admin_movies_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <%= render "form", movie: @movie %>
    </div>
  </div>
</div>
