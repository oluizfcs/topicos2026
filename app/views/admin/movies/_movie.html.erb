<div id="<%= dom_id movie %>">
  <p>
    <strong>Nome:</strong>
    <%= movie.nome %>
  </p>

  <p>
    <strong>Duração:</strong>
    <%= movie.duracao %>
  </p>

  <p>
    <strong>Data de lançamento:</strong>
    <%= movie.data_lancamento %>
  </p>

  <p>
    <strong>Classificação:</strong>
    <%= movie.classificacao %>
  </p>

  <p>
    <strong>Sinopse:</strong>
    <%= movie.sinopse %>
  </p>

</div>
