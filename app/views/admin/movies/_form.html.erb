<%= form_with(model: [:admin, movie], class: "needs-validation", id: "form-movie", multipart: true) do |form| %>

  <% if movie.errors.any? %>
    <div class="alert alert-danger">
      <h6 class="fw-bold"><%= pluralize(movie.errors.count, "erro") %> impediram o salvamento:</h6>
      <ul class="mb-0">
        <% movie.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :nome, class: "form-label fw-semibold" %>
    <%= form.text_field :nome, class: "form-control #{"is-invalid" if movie.errors[:nome].any?}" %>
    <% if movie.errors[:nome].any? %>
      <div class="invalid-feedback d-block">
        <%= movie.errors[:nome].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3" style="display: flex; gap: 10px; align-items: center;">
    <%= form.label :duracao, "Duração: ", class: "form-label fw-semibold mb-0" %>
    <%= form.number_field :horas, onchange: "calcularDuracao();", style: "max-width: 85px;", class: "form-control #{"is-invalid" if movie.errors[:duracao].any?}" %>
    <%= form.label :horas, "hora(s) e", class: "form-label fw-semibold mb-0" %>
    <%= form.number_field :minutos, onchange: "calcularDuracao();", style: "max-width: 85px;", class: "form-control #{"is-invalid" if movie.errors[:duracao].any?}" %>
    <%= form.label :minutos, "minuto(s)", class: "form-label fw-semibold mb-0" %>
    <%= form.hidden_field :duracao %>
    <% if movie.errors[:duracao].any? %>
      <div class="invalid-feedback d-block">
        <%= movie.errors[:duracao].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :data_lançamento, "Data de lançamento", class: "form-label fw-semibold" %>
    <%= form.date_field :data_lancamento, class: "form-control #{"is-invalid" if movie.errors[:data_lancamento].any?}" %>
    <% if movie.errors[:data_lancamento].any? %>
      <div class="invalid-feedback d-block">
        <%= movie.errors[:data_lancamento].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :classificacao, "Classificação", class: "form-label fw-semibold" %>
    <%= form.select :classificacao, ["L", "10", "12", "14", "16", "18"], {}, { class: "form-control #{"is-invalid" if movie.errors[:classificacao].any?}" } %>
    <% if movie.errors[:classificacao].any? %>
      <div class="invalid-feedback d-block">
        <%= movie.errors[:classificacao].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :sinopse, class: "form-label fw-semibold" %>
    <%= form.text_area :sinopse, class: "form-control #{"is-invalid" if movie.errors[:sinopse].any?}", rows: 4 %>
    <% if movie.errors[:sinopse].any? %>
      <div class="invalid-feedback d-block">
        <%= movie.errors[:sinopse].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :genre_ids, "Gêneros", class: "form-label fw-semibold" %>
    <%= form.collection_select :genre_ids, Genre.all, :id, :nome, {}, { multiple: true, class: "form-control #{"is-invalid" if movie.errors[:genres].any?}" } %>
    <% if movie.errors[:genre_ids].any? %>
      <div class="invalid-feedback d-block">
        <%= movie.errors[:genres].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :people, "Pessoas vinculadas", class: "form-label fw-semibold" %>

    <% 
      config_relacoes = {
        "ator"    => { label: "Ator",     tem_personagem: true },
        "diretor" => { label: "Diretor",  tem_personagem: false },
        "produtor"=> { label: "Produtor", tem_personagem: false },
        "escritor"=> { label: "Escritor", tem_personagem: false }
      }
    %>

    <% index_counter = 0 %>
    <% config_relacoes.each do |tipo, config| %>
      <% @movie.people.where(tipo: tipo).each do |item| %>
        <div class="d-flex align-items-center gap-2 mb-2 card-vinculo">

          <input type="hidden" name="movie[people_attributes][<%= index_counter %>][id]" value="<%= item.id %>">
          <input type="hidden" name="movie[people_attributes][<%= index_counter %>][person_id]" value="<%= item.person_id %>">
          <input type="hidden" name="movie[people_attributes][<%= index_counter %>][tipo]" value="<%= item.tipo %>">

          <span class="badge bg-secondary"><%= config[:label] %></span>
          <span><%= item.person.nome %></span>

          <% if config[:tem_personagem] %>
            <input type="text"
                  name="movie[people_attributes][<%= index_counter %>][papel]"
                  value="<%= item.papel %>"
                  class="form-control form-control-sm" style="width:180px"
                  placeholder="Personagem">
          <% end %>

          <input type="hidden" name="movie[people_attributes][<%= index_counter %>][_destroy]" value="0">
          <input type="checkbox"
                name="movie[people_attributes][<%= index_counter %>][_destroy]"
                value="1"
                class="form-check-input" title="Remover">
          <label class="form-check-label text-danger small">Remover</label>
          
        </div>
        <% index_counter += 1 %>
      <% end %>
    <% end %>

    <div id="vinculos-container" data-offset="<%= index_counter %>"></div>
    <button type="button" id="btn-vincular" class="btn btn-outline-secondary btn-sm mt-2">
      + Vincular pessoa
    </button>

    <template id="template-vinculo">
      <div class="card mb-2 card-vinculo">
        <div class="card-body p-2">
          <input type="text" class="form-control mb-2 campo-busca" placeholder="Buscar pelo nome da pessoa...">
          <div class="lista-resultados list-group mb-2"></div>
          <input type="hidden" name="" class="campo-pessoa-id">
          <div class="d-flex mb-1">
            <img class="foto-pessoa rounded-circle ms-2 me-2" style="max-width: 42px" alt="" aria-hidden="true">
            <span class="nome-pessoa fs-3"></span>
          </div>
          <select name="" class="form-select form-select-sm mb-2 campo-tipo">
            <option value="ator">Ator</option>
            <option value="diretor">Diretor</option>
            <option value="produtor">Produtor</option>
            <option value="escritor">Escritor</option>
          </select>
          <input type="text" name="" class="form-control form-control-sm campo-personagem" placeholder="Nome do personagem">
          <button type="button" class="btn btn-sm btn-outline-danger mt-1 btn-remover">
            Remover vínculo
          </button>
        </div>
      </div>
    </template>

    <% if movie.errors[:people].any? %>
      <div class="invalid-feedback d-block">
        <%= movie.errors[:people].join(", ") %>
      </div>
    <% end %>
  </div>

  <% if @movie.persisted? %>
    <div class="mb-4">
      <label class="form-label fw-bold">Imagens cadastradas</label>
      <div class="d-flex flex-wrap gap-3">
        <% @movie.movie_photos.each do |imagem| %>
          <div id="img-container-<%= imagem.id %>" class="text-center" style="width: 130px">
            <%= image_tag imagem.image_url, alt: "", class: "img-thumbnail mb-1", style: "height: 90px; object-fit: cover" %>
            <%# {{-- Radio para definir como poster --}} %>
            <div class="campo-imagem form-check form-check-inline">
              <input class="form-check-input" id="img-<%= imagem.id %>" type="radio"
              name="movie[poster_index]"
              value="0"
              <%= imagem.is_poster? ? 'checked' : '' %>>
            <label for="img-<%= imagem.id %>" class="form-check-label small">Poster</label>
            </div>
            <%# {{-- Botão de remoção individual --}} %>
            <%= link_to "Excluir", "/admin/images/#{imagem.id}/movie/#{imagem.movie.id}",
              data: {
                turbo_method: :delete,
                turbo_confirm: "Tem certeza que deseja excluir?"
              }, class: "delete-image btn btn-outline-danger btn-sm w-100" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <label class="form-label fw-bold">Upload fotos</label>
  <!--  {{-- Container que recebe os novos campos --}}-->
  <div id="campos-imagem">
    <div class="campo-imagem mb-2 d-flex align-items-center gap-2">
      <input type="file" name="movie[photos][]" class="form-control <%= "is-invalid" if movie.errors[:movie_photos].any? %>"
             accept="image/jpeg,image/png,image/webp">
      <label class="mb-0">
        <input type="radio" name="movie[poster_index]" value="0"> Poster
      </label>
    </div>
    <% if movie.errors[:movie_photos].any? %>
      <div class="invalid-feedback d-block">
        <%= movie.errors[:movie_photos].join(", ") %>
      </div>
    <% end %>
  </div>
  <button type="button" id="btn-adicionar" class="btn btn-outline-secondary btn-sm">
    + Adicionar imagem
  </button>

  <div class="d-flex gap-2 mt-4">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancelar", admin_movies_path, class: "btn btn-outline-secondary" %>
  </div>

<% end %>

<script>
{
  const containerImg = document.getElementById('campos-imagem');
  const btnAdicionar = document.getElementById('btn-adicionar');

  function reindexarCampos() {
    const campos = document.querySelectorAll('.campo-imagem');
    campos.forEach((campo, i) => {
      const radio = campo.querySelector('input[name="movie[poster_index]"]');
      if (radio) radio.value = i;
    });
  }

  document.getElementById("form-movie").addEventListener("submit", reindexarCampos);

  btnAdicionar.addEventListener('click', () => {
      const div = document.createElement('div');
      div.className = 'campo-imagem mb-2 d-flex align-items-center gap-2';
      div.innerHTML = `
        <input type="file" name="movie[photos][]" class="form-control"
        accept="image/jpeg,image/png,image/webp">
        <label class="mb-0">
        <input type="radio" name="movie[poster_index]" value="0"> Poster
        </label>
        <button type="button" class="btn btn-sm btn-outline-danger"
        onclick="this.closest('.campo-imagem').remove();">✕</button>`;
      containerImg.appendChild(div);
  });

  const filmeId = "<%= movie.id %>";
  const container = document.getElementById('vinculos-container');
  const template = document.getElementById('template-vinculo');
  const csrfToken = document.querySelector('meta[name="csrf-token"]').content;

  let indice = document.querySelectorAll('.card-vinculo').length;

  document.getElementById('btn-vincular').addEventListener('click', () => {
    const card = template.content.cloneNode(true).querySelector('.card-vinculo');
    // Nomeia os campos com o índice atual
    card.querySelector('.campo-pessoa-id').name = `movie[people_attributes][${indice}][person_id]`;
    card.querySelector('.campo-tipo').name = `movie[people_attributes][${indice}][tipo]`;
    card.querySelector('.campo-personagem').name = `movie[people_attributes][${indice}][papel]`;
    inicializarCard(card);
    container.appendChild(card);
    indice++;
  });

  function inicializarCard(card) {
    const campoBusca = card.querySelector('.campo-busca');
    const listaResultados = card.querySelector('.lista-resultados');
    let timer;
    // Debounce: aguarda 300ms após o usuário parar de digitar
    campoBusca.addEventListener('input', () => {
      clearTimeout(timer);
      timer = setTimeout(() => buscarPessoas(campoBusca.value, listaResultados, card), 300);
    });
    // Exibir/ocultar campo de personagem conforme o tipo
    card.querySelector('.campo-tipo').addEventListener('change', (e) => {
      card.querySelector('.campo-personagem').style.display =
        e.target.value === 'ator' ? 'block' : 'none';
    });
    // Remover card
    card.querySelector('.btn-remover').addEventListener('click', () => {
      card.remove();
      reindexarVinculos();
    });
  }

  function buscarPessoas(termo, lista, card) {
    if (termo.length < 2) { lista.innerHTML = ''; return; }
    fetch(`/admin/people/buscar?q=${encodeURIComponent(termo)}&movie_id=${filmeId ?? ''}`, {
      headers: { 'Accept': 'application/json' }
    })
    .then(res => res.json())
    .then(pessoas => {
      lista.innerHTML = '';
      if (pessoas.length === 0) {
        lista.innerHTML = '<span class="list-group-item text-muted">Nenhum resultado</span>';
        return;
      }

      pessoas.forEach(p => {
        const item = document.createElement('button');
        item.type = 'button';
        item.className = 'list-group-item list-group-item-action';
        // Avisa se já existe vínculo deste tipo
        const aviso = p.vinculos.length > 0
        ? ` <small class="text-warning">(já vinculado como ${p.vinculos.join(', ')})</small>`
        : '';
        item.innerHTML = `${p.nome}${aviso}`;
        item.addEventListener('click', () => {
          // Preenche os campos ocultos e exibe o nome selecionado
          card.querySelector('.campo-pessoa-id').value = p.id;
          card.querySelector('.campo-busca').value = '';
          card.querySelector('.nome-pessoa').textContent = ' ' + p.nome;
          if (p.foto != null) {
            card.querySelector('.foto-pessoa').src = p.foto
          }
          lista.innerHTML = ''; // fecha a lista
        });
        lista.appendChild(item);
        });
    });
  }

  function reindexarVinculos() {
    indice = 0;
    container.querySelectorAll('.card-vinculo').forEach((card) => { 
      card.querySelector('.campo-pessoa-id').name = `movie[people_attributes][${indice}][person_id]`;
      card.querySelector('.campo-tipo').name = `movie[people_attributes][${indice}][tipo]`;
      card.querySelector('.campo-personagem').name = `movie[people_attributes][${indice}][papel]`;
      indice++;
    });
  }

  const duracaoHoras = document.getElementById("movie_horas");
  const duracaoMinutos = document.getElementById("movie_minutos");
  const movieDuracao = document.getElementById("movie_duracao");

  duracaoHoras.value = 0;
  duracaoMinutos.value = 0;

  if (movieDuracao.value == "") movieDuracao.value = 0;

  if (movieDuracao.value != "" && parseInt(movieDuracao.value) > 0) {
    duracaoHoras.value = parseInt(movieDuracao.value / 60);
    duracaoMinutos.value = parseInt(movieDuracao.value % 60);
  }

  function calcularDuracao() {
    if (duracaoHoras.value == "") duracaoHoras.value = 0;
    if (duracaoMinutos.value == "") duracaoMinutos.value = 0;
    if (duracaoMinutos.value == "0" && duracaoHoras.value == "0") {
      duracaoHoras.value = Math.trunc(parseInt(movieDuracao.value)/60);
      duracaoMinutos.value = parseInt(movieDuracao.value % 60);
      
    }

    let duracao = (parseInt(duracaoHoras.value) * 60) + parseInt(duracaoMinutos.value);
    movieDuracao.value = duracao;
  }
}
</script>
