<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold">Filme</h1>
    <div>
      <%= link_to "Ver Página Pública", movie_path(@movie), class: "btn btn-outline-secondary me-2" %>
      <%= link_to "Editar", edit_admin_movie_path(@movie), class: "btn btn-warning me-2" %>
      <%= link_to "Voltar", admin_movies_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <% if notice.present? %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= notice %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
  <% end %>


  <div class="card shadow-sm">
    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-sm-3 text-muted">Nome</dt>
        <dd class="col-sm-9"><%= @movie.nome %></dd>
        <dt class="col-sm-3 text-muted">Duração</dt>
        <dd class="col-sm-9"><%= @movie.duracao %></dd>
        <dt class="col-sm-3 text-muted">Data de lançamento</dt>
        <dd class="col-sm-9"><%= @movie.data_lancamento %></dd>
        <dt class="col-sm-3 text-muted">Classificação</dt>
        <dd class="col-sm-9"><%= @movie.classificacao %></dd>
        <dt class="col-sm-3 text-muted">Sinopse</dt>
        <dd class="col-sm-9"><%= @movie.sinopse %></dd>
        <dt class="col-sm-3 text-muted">Gêneros</dt>
        <dd class="col-sm-9"><%= @movie.generos %></dd>
        <dt class="col-sm-3 text-muted">Pessoas</dt>
        <dd class="col-sm-9">
          <% @movie.people.each do |p| %>
            <%= link_to p.person.nome, admin_person_path(p.person) %>
            <%= "- #{p.tipo} #{"(" + p.papel + ")" if p.papel.present?}" %> <br>
          <% end %>
        </dd>
      </dl>
    </div>
    <div class="card-footer text-end">
      <%= link_to "Excluir", [:admin, @movie], data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir?" }, class: "btn btn-danger" %>
    </div>
  </div>
</div>
