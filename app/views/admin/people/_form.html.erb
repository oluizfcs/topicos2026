<%= form_with(model: person, multipart: true, scope: :person, url: person.persisted? ? admin_person_path(person) : admin_people_path, class: "needs-validation") do |form| %>

  <% if person.errors.any? %>
    <div class="alert alert-danger">
      <h6 class="fw-bold"><%= pluralize(person.errors.count, "erro") %> impediram o salvamento:</h6>
      <ul class="mb-0">
        <% person.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :cpf, "CPF", class: "form-label fw-semibold" %>
    <%= form.text_field :cpf, value: "000.000.000-00", class: "form-control #{"is-invalid" if person.errors[:cpf].any?}" %>
    <% if person.errors[:cpf].any? %>
      <div class="invalid-feedback d-block">
        <%= person.errors[:cpf].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :nome, class: "form-label fw-semibold" %>
    <%= form.text_field :nome, class: "form-control #{"is-invalid" if person.errors[:nome].any?}" %>
    <% if person.errors[:nome].any? %>
      <div class="invalid-feedback d-block">
        <%= person.errors[:nome].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :data_nascimento, "Data de nascimento", class: "form-label fw-semibold" %>
    <%= form.date_field :data_nascimento, value: "2010-10-10", class: "form-control #{"is-invalid" if person.errors[:data_nascimento].any?}" %>
    <% if person.errors[:data_nascimento].any? %>
      <div class="invalid-feedback d-block">
        <%= person.errors[:data_nascimento].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :biografia, class: "form-label fw-semibold" %>
    <%= form.text_area :biografia, class: "form-control #{"is-invalid" if person.errors[:biografia].any?}", rows: 4 %>
    <% if person.errors[:biografia].any? %>
      <div class="invalid-feedback d-block">
        <%= person.errors[:biografia].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :genero, "Gênero", class: "form-label fw-semibold" %>
    <%= form.text_field :genero, value: "X", class: "form-control #{"is-invalid" if person.errors[:genero].any?}" %>
    <% if person.errors[:genero].any? %>
      <div class="invalid-feedback d-block">
        <%= person.errors[:genero].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :nacionalidade, class: "form-label fw-semibold" %>
    <%= form.text_field :nacionalidade, value: "Brasileira", class: "form-control #{"is-invalid" if person.errors[:nacionalidade].any?}" %>
    <% if person.errors[:nacionalidade].any? %>
      <div class="invalid-feedback d-block">
        <%= person.errors[:nacionalidade].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :people, "Filmes vinculados", class: "form-label fw-semibold" %>

    <% index_counter = 0 %>
      <% Movie.where("people.person_id" => person.id).each do |movie| %>
        <% movie.people.select { |mp| mp.person_id == person.id }.each do |item| %>
          <div class="d-flex align-items-center gap-2 mb-2 card-vinculo">

            <input type="hidden" name="person[movies][<%= index_counter %>][id]" value="<%= item.id %>">
            <input type="hidden" name="person[movies][<%= index_counter %>][movie_id]" value="<%= movie.id %>">
            <input type="hidden" name="person[movies][<%= index_counter %>][tipo]" value="<%= item.tipo %>">

            <span class="badge bg-secondary"><%= item.tipo.capitalize %></span>
            <span><%= movie.nome %></span>

            <% if item.tipo == "ator" %>
              <input type="text"
                    name="person[movies][<%= index_counter %>][papel]"
                    value="<%= item.papel %>"
                    class="form-control form-control-sm" style="width:180px"
                    placeholder="Personagem">
            <% end %>

            <input type="hidden" name="person[movies][<%= index_counter %>][_destroy]" value="0">
            <input type="checkbox"
                  name="person[movies][<%= index_counter %>][_destroy]"
                  value="1"
                  class="form-check-input" title="Remover">
            <label class="form-check-label text-danger small">Remover</label>
            
          </div>
          <% index_counter += 1 %>
        <% end %>
    <% end %>

    <div id="vinculos-container" data-offset="<%= index_counter %>"></div>
    <button type="button" id="btn-vincular" class="btn btn-outline-secondary btn-sm mt-2">
      + Vincular filme
    </button>

    <template id="template-vinculo">
      <div class="card mb-2 card-vinculo">
        <div class="card-body p-2">
          <input type="text" class="form-control mb-2 campo-busca" placeholder="Buscar pelo nome do filme...">
          <div class="lista-resultados list-group mb-2"></div>
          <input type="hidden" name="" class="campo-filme-id">
          <div class="d-flex mb-1">
            <img class="foto-filme rounded-circle ms-2 me-2" style="max-width: 42px" alt="" aria-hidden="true">
            <span class="nome-filme fs-3"></span>
          </div>
          <select name="" class="form-select form-select-sm mb-2 campo-tipo">
            <option value="ator">Ator</option>
            <option value="diretor">Diretor</option>
            <option value="produtor">Produtor</option>
            <option value="escritor">Escritor</option>
          </select>
          <input type="text" name="" class="form-control form-control-sm campo-personagem" placeholder="Nome do personagem">
          <button type="button" class="btn btn-sm btn-outline-danger mt-1 btn-remover">
            Remover vínculo
          </button>
        </div>
      </div>
    </template>

    <% if person.errors[:movies].any? %>
      <div class="invalid-feedback d-block">
        <%= person.errors[:movies].join(", ") %>
      </div>
    <% end %>
  </div>

  <% unless @person.photos.empty? %>
    <div class="mb-4">
      <label class="form-label fw-bold">Imagens cadastradas</label>
      <div class="d-flex flex-wrap gap-3">
        <% @person.photos.each do |imagem| %>
          <div id="img-container-<%= imagem.id %>" class="text-center" style="width: 130px">
            <%= image_tag imagem.image_url, alt: "", class: "img-thumbnail mb-1", style: "height: 90px; object-fit: cover" %>

            <%# {{-- Botão de remoção individual --}} %>
            <%= link_to "Excluir", "/admin/images/#{imagem.id}/person/#{imagem.person.id}",
              data: {
                turbo_method: :delete,
                turbo_confirm: "Tem certeza que deseja excluir?"
              }, class: "delete-image btn btn-outline-danger btn-sm w-100" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <label class="form-label fw-bold">Upload Fotos</label>
  <!--  {{-- Container que recebe os novos campos --}}-->
  <div id="campos-imagem">
    <div class="campo-imagem mb-2 d-flex align-items-center gap-2">
      <input type="file" name="person[photos][]" class="form-control"
             accept="image/jpeg,image/png,image/webp">
    </div>
  </div>
  <button type="button" id="btn-adicionar" class="btn btn-outline-secondary btn-sm">
    + Adicionar imagem
  </button>

  <div class="d-flex gap-2 mt-4">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancelar", admin_people_path, class: "btn btn-outline-secondary" %>
  </div>

<% end %>

<script>
  {
    const containerImg = document.getElementById('campos-imagem');
    const btnAdicionar = document.getElementById('btn-adicionar');

    btnAdicionar.addEventListener('click', () => {
        const div = document.createElement('div');
        div.className = 'campo-imagem mb-2 d-flex align-items-center gap-2';
        div.innerHTML = `
          <input type="file" name="person[photos][]" class="form-control"
          accept="image/jpeg,image/png,image/webp">
          <button type="button" class="btn btn-sm btn-outline-danger"
          onclick="this.closest('.campo-imagem').remove();">✕</button>`;
        containerImg.appendChild(div);
    });

    const pessoaId = "<%= person.id %>";
    const container = document.getElementById('vinculos-container');
    const template = document.getElementById('template-vinculo');
    const csrfToken = document.querySelector('meta[name="csrf-token"]').content;

    let indice = document.querySelectorAll('.card-vinculo').length;

    document.getElementById('btn-vincular').addEventListener('click', () => {
      const card = template.content.cloneNode(true).querySelector('.card-vinculo');
      // Nomeia os campos com o índice atual
      card.querySelector('.campo-filme-id').name = `person[movies][${indice}][movie_id]`;
      card.querySelector('.campo-tipo').name = `person[movies][${indice}][tipo]`;
      card.querySelector('.campo-personagem').name = `person[movies][${indice}][papel]`;
      inicializarCard(card);
      container.appendChild(card);
      indice++;
    });

    function inicializarCard(card) {
      const campoBusca = card.querySelector('.campo-busca');
      const listaResultados = card.querySelector('.lista-resultados');
      let timer;
      // Debounce: aguarda 300ms após o usuário parar de digitar
      campoBusca.addEventListener('input', () => {
        clearTimeout(timer);
        timer = setTimeout(() => buscarFilmes(campoBusca.value, listaResultados, card), 300);
      });
      // Exibir/ocultar campo de personagem conforme o tipo
      card.querySelector('.campo-tipo').addEventListener('change', (e) => {
        card.querySelector('.campo-personagem').style.display =
          e.target.value === 'ator' ? 'block' : 'none';
      });
      // Remover card
      card.querySelector('.btn-remover').addEventListener('click', () => {
        card.remove();
        reindexarVinculos();
      });
    }

    function buscarFilmes(termo, lista, card) {
      if (termo.length < 2) { lista.innerHTML = ''; return; }
      fetch(`/admin/movies/buscar?q=${encodeURIComponent(termo)}&person_id=${pessoaId ?? ''}`, {
        headers: { 'Accept': 'application/json' }
      })
      .then(res => res.json())
      .then(filmes => {
        lista.innerHTML = '';
        if (filmes.length === 0) {
          lista.innerHTML = '<span class="list-group-item text-muted">Nenhum resultado</span>';
          return;
        }

        filmes.forEach(p => {
          const item = document.createElement('button');
          item.type = 'button';
          item.className = 'list-group-item list-group-item-action';
          // Avisa se já existe vínculo deste tipo
          const aviso = p.vinculos.length > 0
          ? ` <small class="text-warning">(já vinculado como ${p.vinculos.join(', ')})</small>`
          : '';
          item.innerHTML = `${p.nome}${aviso}`;
          item.addEventListener('click', () => {
            // Preenche os campos ocultos e exibe o nome selecionado
            card.querySelector('.campo-filme-id').value = p.id;
            card.querySelector('.campo-busca').value = '';
            card.querySelector('.nome-filme').textContent = ' ' + p.nome;
            if (p.foto != null) {
              card.querySelector('.foto-filme').src = p.foto
            }
            lista.innerHTML = ''; // fecha a lista
          });
          lista.appendChild(item);
          });
      });
    }

    function reindexarVinculos() {
      indice = 0;
      container.querySelectorAll('.card-vinculo').forEach((card) => { 
        card.querySelector('.campo-filme-id').name = `person[movies][${indice}][movie_id]`;
        card.querySelector('.campo-tipo').name = `person[movies][${indice}][tipo]`;
        card.querySelector('.campo-personagem').name = `person[movies][${indice}][papel]`;
        indice++;
      });
    }
  }
</script>