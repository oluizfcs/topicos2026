<%= form_with(model: person, multipart: true, scope: :person, url: person.persisted? ? admin_person_path(person) : admin_people_path, class: "needs-validation") do |form| %>

  <% if person.errors.any? %>
    <div class="alert alert-danger">
      <h6 class="fw-bold"><%= pluralize(person.errors.count, "erro") %> impediram o salvamento:</h6>
      <ul class="mb-0">
        <% person.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :cpf, "CPF", class: "form-label fw-semibold" %>
    <%= form.text_field :cpf, value: "000.000.000-00", class: "form-control #{"is-invalid" if person.errors[:cpf].any?}" %>
    <% if person.errors[:cpf].any? %>
      <div class="invalid-feedback d-block">
        <%= person.errors[:cpf].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :nome, class: "form-label fw-semibold" %>
    <%= form.text_field :nome, class: "form-control #{"is-invalid" if person.errors[:nome].any?}" %>
    <% if person.errors[:nome].any? %>
      <div class="invalid-feedback d-block">
        <%= person.errors[:nome].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :data_nascimento, "Data de nascimento", class: "form-label fw-semibold" %>
    <%= form.date_field :data_nascimento, value: "2010-10-10", class: "form-control #{"is-invalid" if person.errors[:data_nascimento].any?}" %>
    <% if person.errors[:data_nascimento].any? %>
      <div class="invalid-feedback d-block">
        <%= person.errors[:data_nascimento].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :biografia, class: "form-label fw-semibold" %>
    <%= form.text_area :biografia, class: "form-control #{"is-invalid" if person.errors[:biografia].any?}", rows: 4 %>
    <% if person.errors[:biografia].any? %>
      <div class="invalid-feedback d-block">
        <%= person.errors[:biografia].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :genero, "Gênero", class: "form-label fw-semibold" %>
    <%= form.text_field :genero, value: "X", class: "form-control #{"is-invalid" if person.errors[:genero].any?}" %>
    <% if person.errors[:genero].any? %>
      <div class="invalid-feedback d-block">
        <%= person.errors[:genero].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :nacionalidade, class: "form-label fw-semibold" %>
    <%= form.text_field :nacionalidade, value: "Brasileira", class: "form-control #{"is-invalid" if person.errors[:nacionalidade].any?}" %>
    <% if person.errors[:nacionalidade].any? %>
      <div class="invalid-feedback d-block">
        <%= person.errors[:nacionalidade].join(", ") %>
      </div>
    <% end %>
  </div>

  <% unless @person.photos.empty? %>
    <div class="mb-4">
      <label class="form-label fw-bold">Imagens cadastradas</label>
      <div class="d-flex flex-wrap gap-3">
        <% @person.photos.each do |imagem| %>
          <div id="img-container-<%= imagem.id %>" class="text-center" style="width: 130px">
            <%= image_tag imagem.image_url, alt: "", class: "img-thumbnail mb-1", style: "height: 90px; object-fit: cover" %>

            <%# {{-- Botão de remoção individual --}} %>
            <%= link_to "Excluir", "/admin/images/#{imagem.id}/person/#{imagem.person.id}",
              data: {
                turbo_method: :delete,
                turbo_confirm: "Tem certeza que deseja excluir?"
              }, class: "delete-image btn btn-outline-danger btn-sm w-100" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <!--  {{-- Container que recebe os novos campos --}}-->
  <div id="campos-imagem">
    <div class="campo-imagem mb-2 d-flex align-items-center gap-2">
      <input type="file" name="person[photos][]" class="form-control"
             accept="image/jpeg,image/png,image/webp">
    </div>
  </div>
  <button type="button" id="btn-adicionar" class="btn btn-outline-secondary btn-sm">
    + Adicionar imagem
  </button>

  <div class="d-flex gap-2 mt-4">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancelar", admin_people_path, class: "btn btn-outline-secondary" %>
  </div>

<% end %>

<script>
  {
  const containerImg = document.getElementById('campos-imagem');
  const btnAdicionar = document.getElementById('btn-adicionar');

  btnAdicionar.addEventListener('click', () => {
      const div = document.createElement('div');
      div.className = 'campo-imagem mb-2 d-flex align-items-center gap-2';
      div.innerHTML = `
        <input type="file" name="person[photos][]" class="form-control"
        accept="image/jpeg,image/png,image/webp">
        <button type="button" class="btn btn-sm btn-outline-danger"
        onclick="this.closest('.campo-imagem').remove();">✕</button>`;
      containerImg.appendChild(div);
  });
  }
</script>