<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold">Pessoa</h1>
    <div>
      <%= link_to "Ver Página Pública", person_path(@person), class: "btn btn-outline-secondary me-2" %>
      <%= link_to "Editar", edit_admin_person_path(@person), class: "btn btn-warning me-2" %>
      <%= link_to "Voltar", admin_people_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <% if notice.present? %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= notice %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
  <% end %>

  <div class="card shadow-sm">
    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-sm-3 text-muted">CPF</dt>
        <dd class="col-sm-9"><%= @person.cpf %></dd>
        <dt class="col-sm-3 text-muted">Nome</dt>
        <dd class="col-sm-9"><%= @person.nome %></dd>
        <dt class="col-sm-3 text-muted">Data de nascimento</dt>
        <dd class="col-sm-9"><%= @person.data_nascimento %></dd>
        <dt class="col-sm-3 text-muted">Biografia</dt>
        <dd class="col-sm-9"><%= @person.biografia %></dd>
        <dt class="col-sm-3 text-muted">Gênero</dt>
        <dd class="col-sm-9"><%= @person.genero %></dd>
        <dt class="col-sm-3 text-muted">Nacionalidade</dt>
        <dd class="col-sm-9"><%= @person.nacionalidade %></dd>
      </dl>
        <% if @person.photos.present? %>
        <p class="fs-3 fw-bold">Fotos (<%= @person.photos.size %>)</p>
          <% @person.photos.each do |photo| %>
            <%= image_tag photo.image_url, alt: "Foto de #{@person.nome}", style: "max-width: 300px; border-raidus: 6px;" %>
          <% end %>
        <% else %>
          <p>Nenuma foto cadastrada.</p>
        <% end %>
    </div>
    <div class="m-2">
      <%= render 'partials/lista_cards', { list_label: "Atuou em", card_list: @credits["ator"] } if @credits["ator"].present? %>
      <%= render 'partials/lista_cards', { list_label: "Dirigiu", card_list: @credits["diretor"] } if @credits["diretor"].present? %>
      <%= render 'partials/lista_cards', { list_label: "Escreveu", card_list: @credits["escritor"] } if @credits["escritor"].present? %>
      <%= render 'partials/lista_cards', { list_label: "Produziu", card_list: @credits["produtor"] } if @credits["produtor"].present? %>
    </div>
    <div class="card-footer text-end">
      <%= link_to "Excluir", [:admin, @person], data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir?" }, class: "btn btn-danger" %>
    </div>
  </div>
</div>
