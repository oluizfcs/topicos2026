<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold">Estúdio</h1>
    <div>
      <%= link_to "Ver Página Pública", studio_path(@studio), class: "btn btn-outline-secondary me-2" %>
      <%= link_to "Editar", edit_admin_studio_path(@studio), class: "btn btn-warning me-2" %>
      <%= link_to "Voltar", admin_studios_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <% if notice.present? %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= notice %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
  <% end %>

  <div class="card shadow-sm">
    <div class="card-body">
      <dl class="row mb-0">
        <dt class="col-sm-3 text-muted">Nome</dt>
        <dd class="col-sm-9"><%= @studio.nome %></dd>
        <dt class="col-sm-3 text-muted">Local</dt>
        <dd class="col-sm-9"><%= @studio.local %></dd>
      </dl>
      <% if @studio.photos.present? %>
        <p class="fs-3 fw-bold">Fotos (<%= @studio.photos.size %>)</p>
        <% @studio.photos.each do |photo| %>
          <%= image_tag photo.image_url, alt: "Foto de #{@studio.nome}", style: "max-width: 300px; border-raidus: 6px;" %>
        <% end %>
      <% else %>
        <p>Nenuma foto cadastrada.</p>
      <% end %>
      <%= render 'partials/lista_cards', { list_label: "Filmes", card_list: @movies } if @movies.present? %>
    </div>
    <div class="card-footer text-end">
      <%= link_to "Excluir", [:admin, @studio], data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir?" }, class: "btn btn-danger" %>
    </div>
  </div>
</div>
