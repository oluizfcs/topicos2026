<div id="<%= dom_id comment %>">
  <p>
    <strong>Name:</strong>
    <%= comment.name %>
  </p>

  <p>
    <strong>Message:</strong>
    <%= comment.message %>
  </p>

  <p>
    <strong>Post:</strong>
    <%= comment.post_id %>
  </p>

  <p>
    <%= link_to 'Delete', [comment],
        data: {
          "turbo-method": :delete,
          "turbo-config": 'Are you sure?'
        }
    %>
  </p>
</div>
