<div class="container">
  <% if alert.present? %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= alert %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
  <% end %>
  <% if notice.present? %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= notice %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
  <% end %>
  <!-- Carrosel -->
  <div class="row justify-content-center">
    <div class="col-md-9 mt-2 mb-2">
      <div id="carouselExample" class="carousel slide">
        <div class="carousel-inner rounded-5">
          <div class="carousel-item active">
            <%= image_tag "yellow-banner.png", alt: "yellow banner", class: "d-block w-100"%>
          </div>
          <div class="carousel-item">
            <%= image_tag "black-banner.png", alt: "black banner", class: "d-block w-100"%>
          </div>
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample"
                data-bs-slide="prev">
          <span class="carousel-control-prev-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Previous</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselExample"
                data-bs-slide="next">
          <span class="carousel-control-next-icon" aria-hidden="true"></span>
          <span class="visually-hidden">Next</span>
        </button>
      </div>
    </div>
  </div>
  <!-- Filmes -->
  <div class="fs-2 mt-4">Filmes em destaque <span class="text-primary">></span></div>
  <div class="row justify-content-center">
    <%= render 'partials/card_filme', { filme: { id: 1, nome: 'filme1' } } %>
    <%= render 'partials/card_filme', { filme: { id: 2, nome: 'filme2' } } %>
    <%= render 'partials/card_filme', { filme: { id: 3, nome: 'filme3' } } %>
  </div>
  <!-- Atores -->
  <div class="fs-2 mt-4">Atores em destaque <span class="text-primary">></span></div>
  <div class="row justify-content-center">
    <%= render 'partials/card_ator', { ator: { id: 1, nome: 'Fulano'} } %>
    <%= render 'partials/card_ator', { ator: { id: 2, nome: 'Sicrano'} } %>
    <%= render 'partials/card_ator', { ator: { id: 3, nome: 'Beltrano'} } %>
  </div>
  <!-- Avaliações -->
  <div class="fs-2 mt-4">Avaliações em destaque <span class="text-primary">></span></div>
  <div class="row justify-content-center">
    <%= render 'partials/card_avaliacao', { avaliacao: { nota: 5, filme: 'filme1', usuario: 'Fulano'} } %>
    <%= render 'partials/card_avaliacao', { avaliacao: { nota: 4, filme: 'filme2', usuario: 'Sicrano'} } %>
    <%= render 'partials/card_avaliacao', { avaliacao: { nota: 3, filme: 'filme3', usuario: 'Beltrano'} } %>
  </div>
</div>