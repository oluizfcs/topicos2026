<div id="<%= dom_id movie %>">
  <p>
    <strong>Nome:</strong>
    <%= movie.nome %>
  </p>

  <p>
    <strong>Duracao:</strong>
    <%= movie.duracao %>
  </p>

  <p>
    <strong>Data lancamento:</strong>
    <%= movie.data_lancamento %>
  </p>

  <p>
    <strong>Classificacao:</strong>
    <%= movie.classificacao %>
  </p>

  <p>
    <strong>Sinopse:</strong>
    <%= movie.sinopse %>
  </p>

</div>
