<%= form_with(model: movie, class: "needs-validation") do |form| %>

  <% if movie.errors.any? %>
    <div class="alert alert-danger">
      <h6 class="fw-bold"><%= pluralize(movie.errors.count, "erro") %> impediram o salvamento:</h6>
      <ul class="mb-0">
        <% movie.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form.label :nome, class: "form-label fw-semibold" %>
    <%= form.text_field :nome, class: "form-control #{"is-invalid" if movie.errors[:nome].any?}" %>
    <% if movie.errors[:nome].any? %>
      <div class="invalid-feedback d-block">
        <%= movie.errors[:nome].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :duracao, class: "form-label fw-semibold" %>
    <%= form.number_field :duracao, class: "form-control #{"is-invalid" if movie.errors[:duracao].any?}" %>
    <% if movie.errors[:duracao].any? %>
      <div class="invalid-feedback d-block">
        <%= movie.errors[:duracao].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :data_lancamento, class: "form-label fw-semibold" %>
    <%= form.date_field :data_lancamento, class: "form-control #{"is-invalid" if movie.errors[:data_lancamento].any?}" %>
    <% if movie.errors[:data_lancamento].any? %>
      <div class="invalid-feedback d-block">
        <%= movie.errors[:data_lancamento].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :classificacao, class: "form-label fw-semibold" %>
    <%= form.text_field :classificacao, class: "form-control #{"is-invalid" if movie.errors[:classificacao].any?}" %>
    <% if movie.errors[:classificacao].any? %>
      <div class="invalid-feedback d-block">
        <%= movie.errors[:classificacao].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form.label :sinopse, class: "form-label fw-semibold" %>
    <%= form.text_area :sinopse, class: "form-control #{"is-invalid" if movie.errors[:sinopse].any?}", rows: 4 %>
    <% if movie.errors[:sinopse].any? %>
      <div class="invalid-feedback d-block">
        <%= movie.errors[:sinopse].join(", ") %>
      </div>
    <% end %>
  </div>

  <div class="d-flex gap-2 mt-4">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancelar", movies_path, class: "btn btn-outline-secondary" %>
  </div>

<% end %>
