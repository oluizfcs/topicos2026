<div class="container mt-4">
  <% if notice.present? %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= notice %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
  <% end %>
  <% if alert.present? %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      <%= alert %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
  <% end %>
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold">Filme</h1>
    <div>
      <%= link_to "Ver no Painel Administrativo", admin_movie_path(@movie), class: "btn btn-outline-secondary me-2" if current_user&.admin? %>
      <%= link_to "Voltar", :back, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="card shadow-sm border-secondary">
    <div class="card-body">
      <div class="clearfix">
      <div>
        <%= image_tag @movie.poster.present? ? @movie.poster.image_url : "star.png", alt: "Poster de " + @movie.nome, class: "float-start img-thumbnail", style: "max-width: 300px; margin-right: 1rem" %>
        </div>
        <h1 class="display-2"><%= @movie.nome %></h1>
        <p><i class="bi bi-star-fill text-primary"></i> <%= @movie.nota %></p>
        <%= @movie.sinopse %>
      </div>

      <dl class="row mt-3 mb-0">
        <dt class="col-sm-3 text-muted">Gêneros</dt>
        <dd class="col-sm-9"><%= @movie.generos %></dd>
        <dt class="col-sm-3 text-muted">Lançamento</dt>
        <dd class="col-sm-9"><%= @movie.data_lancamento.strftime("%d/%m/%Y") %></dd>
        <dt class="col-sm-3 text-muted">Duração</dt>
        <dd class="col-sm-9"><%= @movie.display_duracao %></dd>
        <dt class="col-sm-3 text-muted">Classificação</dt>
        <dd class="col-sm-9"><%= @movie.classificacao %></dd>
      </dl>
      <hr>
      <h2>Direção, Roteiro e Produção</h2>
      <dl class="row mt-3 mb-0">
        <dt class="col-sm-3 text-muted">Diretor(es)</dt>
        <dd class="col-sm-9"><%= @movie.people.where(tipo: "diretor").map{ |mp| link_to mp.person.nome, mp.person }.to_a.join(', ').html_safe %></dd>
        <dt class="col-sm-3 text-muted">Roteirista(s)</dt>
        <dd class="col-sm-9"><%= @movie.people.where(tipo: "escritor").map{ |mp| link_to mp.person.nome, mp.person }.to_a.join(', ').html_safe %></dd>
        <dt class="col-sm-3 text-muted">Produtor(es)</dt>
        <dd class="col-sm-9"><%= @movie.people.where(tipo: "produtor").map{ |mp| link_to mp.person.nome, mp.person }.to_a.join(', ').html_safe %>
      </dl>
      <%= render 'partials/lista_cards', { list_label: "Elenco", card_list: @elenco } if @elenco.present? %>
      <% if @movie.movie_photos.size > 1 %>
      <hr>
      <p class="fs-3 fw-bold">Fotos (<%= @movie.movie_photos.size-1 %>)</p>
        <% @movie.movie_photos.each do |photo| %>
          <%= image_tag photo.image_url, alt: "", style: "max-width: 300px; border-raidus: 6px;" unless photo.is_poster? %>
        <% end %>
      <% end %>
      <hr>
      <% if current_user.present? %>
        <% if @review.persisted? %>
          <h2>Sua avaliação</h2>
          <%= render @review %>
        <% else %>
          <%= render "reviews/form", movie: @movie, review: @review %>
        <% end %>
        <hr>
      <% end %>      
      <h2>Avaliações dos usuários</h2>
      <% if @reviews.size > 0 %>
        <%= render @reviews %>
      <% elsif user_signed_in? && @review.persisted? %>
        <p>Só você avaliou este filme por enquanto.</p>
      <% else %>
        <p>Este filme não tem avaliações por enquanto.</p>
      <% end %>
    </div>
  </div>
</div>

<% if @review.present? %>
<div class="modal fade" id="edit-review-modal-<%= @review.id %>" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
      </div>
      <div class="modal-body">
        <%= render "reviews/form", movie: @movie, review: @review, title: "Editar Avaliação" %>
      </div>
    </div>
  </div>
</div>
<% end %>
