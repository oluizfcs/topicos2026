<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold">Movies</h1>
    <%= link_to "Novo Movie", new_movie_path, class: "btn btn-primary" %>
  </div>

  <% if notice.present? %>
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      <%= notice %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
    </div>
  <% end %>

  <div class="card shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
          <thead class="table-dark">
            <tr>
                            <th>Nome</th>
                            <th>Duracao</th>
                            <th>Data lancamento</th>
                            <th>Classificacao</th>
                            <th>Sinopse</th>
                            <th class="text-end">Ações</th>
            </tr>
          </thead>
          <tbody>
            <% @movies.each do |movie| %>
              <tr>
                                <td><%= movie.nome %></td>
                                <td><%= movie.duracao %></td>
                                <td><%= movie.data_lancamento %></td>
                                <td><%= movie.classificacao %></td>
                                <td><%= movie.sinopse %></td>
                                <td class="text-end">
                  <%= link_to "Ver", movie, class: "btn btn-sm btn-outline-info me-1" %>
                  <%= link_to "Editar", edit_movie_path(movie), class: "btn btn-sm btn-outline-warning me-1" %>
                  <%= link_to "Excluir", movie, data: { turbo_method: :delete, turbo_confirm: "Tem certeza que deseja excluir?" }, class: "btn btn-sm btn-outline-danger" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
