<div id="<%= dom_id person %>">
  <p>
    <strong>Cpf:</strong>
    <%= person.cpf %>
  </p>

  <p>
    <strong>Nome:</strong>
    <%= person.nome %>
  </p>

  <p>
    <strong>Data nascimento:</strong>
    <%= person.data_nascimento %>
  </p>

  <p>
    <strong>Biografia:</strong>
    <%= person.biografia %>
  </p>

  <p>
    <strong>Genero:</strong>
    <%= person.genero %>
  </p>

  <p>
    <strong>Nacionalidade:</strong>
    <%= person.nacionalidade %>
  </p>

</div>
