<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 fw-bold">Editar Person</h1>
    <div>
      <%= link_to "Ver", @person, class: "btn btn-outline-info me-2" %>
      <%= link_to "Voltar", people_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      <%= render "form", person: @person %>
    </div>
  </div>
</div>
