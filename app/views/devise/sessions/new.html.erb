<div class="row justify-content-center">
  <div class="col-md-6 col-sm-12">
    <% if alert.present? %>
      <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <%= alert %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
      </div>
    <% end %>
    <h2 class="display-4 text-center mb-2">Entrar</h2>
    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "card p-5 needs-validation bg-dark" }) do |f| %>
      <div class="form-floating mb-3">
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "", class: "form-control" %>
        <%= f.label :email %>
      </div>

      <div class="form-floating mb-3">
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "", class: "form-control" %>
        <%= f.label :password, "Senha" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-check">
          <p><%= f.check_box :remember_me, class: "form-check-input mb-3" %> <%= f.label :remember_me, "Lembre-se de mim" %></p>
        </div>
      <% end %>

      <%= f.submit "Entrar", class: "btn btn-primary" %>
      
      <div class="text-center mt-3">
        <%= render "devise/shared/links" %>
      </div>
    <% end %>
  </div>
</div>
