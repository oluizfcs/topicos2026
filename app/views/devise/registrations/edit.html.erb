<div class="row justify-content-center">
  <div class="col-md-6 col-sm-12">
    <h2 class="display-4 text-center mb-2">Atualizar Perfil</h2>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), multipart: true, html: { method: :put, class: "card p-5 needs-validation bg-dark" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div class="form-floating mb-3">
        <%= f.text_field :nome, autofocus: true, autocomplete: "nome", placeholder: "", required: true, class: "form-control" %>
        <%= f.label :nome %>
      </div>
      
      <div class="form-floating mb-3">
        <%= f.email_field :email, autocomplete: "email", placeholder: "", disabled: true, required: true, class: "form-control" %>
        <%= f.label :email, "Email (não é possível alterar)" %>
      </div>

      <div class="mb-3">
        <%= f.label :photo, "Foto", class: "form-label fw-semibold" %>
        <%= f.hidden_field :photo, value: resource.cached_photo_data %>
        <%= f.file_field :photo, class: "form-control", accept: "image/*" %>
      </div>

      <hr>
      <h2>Alterar senha</h2>
      <p>Deixe em branco caso não queira alterar.</p>
      
      <div class="form-floating mb-3">
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "", class: "form-control" %>
        <%= f.label :password, "Senha" %>
      </div>

      <div class="form-floating mb-3">
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "", class: "form-control" %>
        <%= f.label :password_confirmation, "Confirmar Senha" %>
      </div>
      <hr>

      <p>Precisamos da sua senha atual para confirmar as alterações.</p>
      <div class="form-floating mb-3">
        <%= f.password_field :current_password, autocomplete: "current-password", placeholder: "", class: "form-control" %>
        <%= f.label :current_password, "Senha Atual" %>
      </div>

<div>
      <%= f.submit "Atualizar", class: "btn btn-primary" %>
      <%= link_to "Cancelar", :back %>
      </div>
    <% end %>
  </div>
</div>
