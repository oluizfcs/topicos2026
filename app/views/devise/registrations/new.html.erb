<div class="row justify-content-center">
  <div class="col-md-6 col-sm-12">
    <h2 class="display-4 text-center mb-2">Cadastrar</h2>
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "card p-5 needs-validation bg-dark" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <div class="form-floating mb-3">
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "", required: true, class: "form-control" %>
        <%= f.label :email %>
      </div>
      
      <div class="form-floating mb-3">
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "", required: true, class: "form-control" %>
        <%= f.label :password, "Senha" %>
      </div>

      <div class="form-floating mb-3">
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "", class: "form-control" %>
        <%= f.label :password_confirmation, "Confirmar Senha" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="form-check">
          <p><%= f.check_box :remember_me, class: "form-check-input mb-3" %> <%= f.label :remember_me, "Lembre-se de mim" %></p>
        </div>
      <% end %>

      <%= f.submit "Cadastrar", class: "btn btn-primary" %>
      
      <div class="text-center mt-3">
        <%= render "devise/shared/links" %>
      </div>
    <% end %>
  </div>
</div>
